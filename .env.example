APP_NAME=ChannelBot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_DOMAIN=channelbot.example.com
APP_IMAGE=channelbot-app
TRAEFIK_DOMAIN=traefik.channelbot.example.com
ACME_EMAIL=admin@example.com
TRAEFIK_DASHBOARD_AUTH=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
DB_APPLICATION_NAME=channelbot-local
# Production Docker PostgreSQL connection ceiling.
POSTGRES_MAX_CONNECTIONS=200

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_ANALYSIS_MODEL=google/gemini-3-flash-preview
OPENROUTER_ANALYSIS_FALLBACK_MODEL=openai/gpt-5-mini
OPENROUTER_REWRITE_MODEL=google/gemini-3.6-flash
OPENROUTER_REWRITE_FALLBACK_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_TIMEOUT=300
OPENROUTER_CONNECT_TIMEOUT=10
CONTENT_DUPLICATE_LOOKBACK_DAYS=14
CONTENT_DUPLICATE_HISTORY_LIMIT=80
CONTENT_RETENTION_DAYS=14
REDIS_QUEUE_RETRY_AFTER=420
DB_QUEUE_RETRY_AFTER=420
HORIZON_TELEGRAM_PROCESSES=3

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_API_URL=https://api.telegram.org
MESSENGER_BASE_URL=https://t.me
TELEGRAM_BOT_API_TIMEOUT=300
TELEGRAM_BOT_API_CONNECT_TIMEOUT=10
TELEGRAM_PUBLISHING_STALE_AFTER=600
TELEGRAM_OPERATIONS_CHAT_ID=-1004403081411
TELEGRAM_OPERATIONS_CONTENT_PLANS_TOPIC_ID=4
TELEGRAM_OPERATIONS_FAILURES_TOPIC_ID=5
TELEGRAM_OPERATIONS_TIMEOUT=10
TELEGRAM_OPERATIONS_CONNECT_TIMEOUT=3
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_SERVER_URL=http://telegram-api:9503
TELEGRAM_API_SERVER_WEBSOCKET_URL=ws://telegram-api:9503/events
TELEGRAM_API_SERVER_CONNECT_TIMEOUT=5
TELEGRAM_API_SERVER_TIMEOUT=30
TELEGRAM_API_SERVER_DOWNLOAD_TIMEOUT=330
TELEGRAM_API_SERVER_MEMORY_LIMIT=512M
TELEGRAM_API_SERVER_LOG_LEVEL=2
# Shared MadelineProto PostgreSQL pool.
TELEGRAM_DATABASE_MAX_CONNECTIONS=20
TELEGRAM_DATABASE_IDLE_TIMEOUT=300
TELEGRAM_DATABASE_CACHE_TTL="+5 minutes"
TELEGRAM_DOWNLOAD_PARALLEL_CHUNKS=4
TELEGRAM_RPC_DROP_TIMEOUT=60
TELEGRAM_IPV6=false
TELEGRAM_OWNER_HEARTBEAT_SECONDS=15
TELEGRAM_OWNER_LEASE_TTL_SECONDS=45
TELEGRAM_COORDINATION_CACHE_STORE=redis
# Optional SOCKS5 egress for MadelineProto user sessions.
TELEGRAM_SOCKS5_HOST=
TELEGRAM_SOCKS5_PORT=1080
TELEGRAM_SOCKS5_USERNAME=
TELEGRAM_SOCKS5_PASSWORD=
TELEGRAM_SOCKS5_PROXY_ONLY=true
TELEGRAM_SOCKS5_HTTPS_TRANSPORT=true
TELEGRAM_BRIDGE_SECRET=
TELEGRAM_BRIDGE_URL=http://laravel.test/api/internal/telegram/updates
TELEGRAM_SUBSCRIPTIONS_URL=http://laravel.test/api/internal/telegram/subscriptions
# Production Docker only: defaults to the internal app service when omitted.
# TELEGRAM_BRIDGE_URL_INTERNAL=http://app:8080/api/internal/telegram/updates
# TELEGRAM_SUBSCRIPTIONS_URL_INTERNAL=http://app:8080/api/internal/telegram/subscriptions
TELEGRAM_MEDIA_MAX_BYTES=52428800
